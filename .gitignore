# =====================================================================
# .gitignore - Sistema Punto de Venta (Python / FastAPI / SQLite / Web)
# =====================================================================

# --- Entornos Virtuales de Python ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Caché y Bytecode de Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- Bases de Datos y Datos Sensibles / Pesados (>100MB) ---
data/*
!data/.gitkeep
data/.eleventa_migrado
data/eleventa_import_status.json
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/test_*.bat
*.db
*.sqlite
*.sqlite3
*.fdb

# --- Copias de Seguridad y Respaldos ---
respaldos/*
!respaldos/.gitkeep
*.bak
*.backup

# --- Herramientas Externas / Binarios Descargados en Instalación ---
tools/python32/
tools/fdb_dist/
tools/*.zip
tools/*.tar.gz
tools/*.whl

# --- Secretos, Credenciales y Variables de Entorno ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Registros (Logs) y Temporales ---
*.log
logs/
temp/
tmp/
*.tmp
*.temp

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Entornos de Desarrollo y Editores ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# --- Pruebas y Reportes de Cobertura ---
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/
htmlcov/
scratch/
